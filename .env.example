# Gemini Authentication Cookies
# Get these from your browser's cookies when logged into gemini.google.com
# In Chrome: F12 → Application → Cookies → https://gemini.google.com
SECURE_1PSID=your_secure_1psid_cookie_value
SECURE_1PSIDTS=your_secure_1psidts_cookie_value

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Proxy configuration
# PROXY_URL=http://proxy:port

# Gemini client timeouts (seconds)
# GEMINI_TIMEOUT: httpx request timeout for gemini-webapi (default: 60)
GEMINI_TIMEOUT=60
# GEMINI_WATCHDOG_TIMEOUT: stall detection timeout (default: 30)
GEMINI_WATCHDOG_TIMEOUT=30
# GENERATE_TIMEOUT: outer wall-clock cap for non-streaming calls (default: 120)
GENERATE_TIMEOUT=120

# Log level for gemini-webapi library (DEBUG, INFO, WARNING, ERROR)
GEMINI_LOG_LEVEL=DEBUG

# Debug mode - enables verbose logging of request/response content
DEBUG=true